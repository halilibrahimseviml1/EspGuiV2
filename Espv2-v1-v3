-- ESP Toggle Butonları Oluşturucu
local function createToggle(name, configKey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(40, 180, 80) or Color3.fromRGB(40, 40, 40)
    btn.BorderSizePixel = 0
    btn.Text = name .. ": " .. (Config[configKey] and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.Parent = ESPContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(40, 180, 80) or Color3.fromRGB(40, 40, 40)
        btn.Text = name .. ": " .. (Config[configKey] and "ON" or "OFF")
    end)
end

