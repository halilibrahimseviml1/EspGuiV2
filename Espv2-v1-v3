-- Discord Webhook Gönderme
SendBtn.MouseButton1Click:Connect(function()
    local text = FeedbackBox.Text
    if text == "" or text == "Write your feedback or bug report here..." then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusLabel.Text = "Please write a message first!"
        return
    end

    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    StatusLabel.Text = "Sending..."

    task.spawn(function()
        local data = {
            content = "",
            embeds = {{
                title = "⚡ New Lightning Hub Feedback",
                description = text,
                color = 65280,
                fields = {
                    {name = "Kullanıcı Adı", value = LocalPlayer.Name, inline = true},
                    {name = "Oyun ID", value = tostring(game.PlaceId), inline = true}
                },
                footer = {text = "Lightning Hub - Feedback System"}
            }}
        }

        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
        local success = pcall(function()
            if requestFunc then
                requestFunc({
                    Url = Config.webhook,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(data)
                })
            else
                HttpService:PostAsync(Config.webhook, HttpService:JSONEncode(data))
            end
        end)

        if success then
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            StatusLabel.Text = "Sent successfully! Thank you."
            FeedbackBox.Text = ""
            task.wait(2)
            if StatusLabel then StatusLabel.Text = "" end
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "Failed to send! Check Executor support."
        end
    end)
end)

-- ESP Mantığı (Render Loop)
local espCache = {}

local function removeESP(player)
    if espCache[player] then
        if espCache[player].folder then
            espCache[player].folder:Destroy()
        end
        espCache[player] = nil
    end
end

local function updateESP()
    if not Config.enabled then
        for _, cache in pairs(espCache) do
            if cache.folder then cache.folder.Parent = nil end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")

            if char and hrp and humanoid and humanoid.Health > 0 then
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude

                if dist <= Config.maxDistance then
                    if not espCache[player] or not espCache[player].folder or espCache[player].folder.Parent ~= workspace then
                        removeESP(player)
                        local folder = Instance.new("Folder")
                        folder.Name = "ESP_" .. player.Name
                        folder.Parent = workspace

                        local highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.Parent = folder

                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "ESPBillboard"
                        billboard.Size = UDim2.new(0, 100, 0, 50)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = folder

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        textLabel.TextStrokeTransparency = 0
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextWrapped = true
                        textLabel.Parent = billboard

                        espCache[player] = {folder = folder, highlight = highlight, billboard = billboard, textLabel = textLabel}
                    end

                    local cache = espCache[player]
                    cache.folder.Parent = workspace

                    -- Box & Chams
                    cache.highlight.Enabled = Config.box
                    cache.highlight.Adornee = char
                    cache.highlight.FillTransparency = Config.chams and 0.3 or 0.5

                    local col = Color3.fromRGB(255, 0, 0)
                    if Config.teamColor and player.Team and LocalPlayer.Team then
                        if player.Team == LocalPlayer.Team then
                            col = Color3.fromRGB(0, 255, 0)
                        else
                            col = Color3.fromRGB(255, 0, 0)
                        end
                    end
                    cache.highlight.FillColor = col
                    cache.highlight.OutlineColor = col

                    -- Text Info
                    cache.billboard.Adornee = char:FindFirstChild("Head") or hrp
                    cache.billboard.Enabled = Config.name or Config.health or Config.distance

                    local infoText = {}
                    if Config.name then table.insert(infoText, player.Name) end
                    if Config.health then table.insert(infoText, "HP: " .. math.floor(humanoid.Health)) end
                    if Config.distance then table.insert(infoText, math.floor(dist) .. "m") end

                    cache.textLabel.Text = table.concat(infoText, "\n")
                else
                    removeESP(player)
                end
            else
                removeESP(player)
            end
        end
    end
end

